<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SmartPantryApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager">

        <activity
            android:name=".ui.PantryListActivity"
            android:exported="true"
            android:label="@string/title_pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:parentActivityName=".ui.PantryListActivity" />

        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false"
            android:label="@string/title_suggested_recipes"
            android:parentActivityName=".ui.PantryListActivity" />

        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe_detail"
            android:parentActivityName=".ui.SuggestedRecipesActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".ui.PantryListActivity" />

    </application>

</manifest>
